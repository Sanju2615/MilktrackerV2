# =====================================================
# Human Milk Tracker - Backend Configuration
# Copy this to .env and update values
# =====================================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=/api/v1

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=milktracker
DB_USER=milktracker_user
DB_PASSWORD=milktracker123
DB_CONNECTION_LIMIT=10

# TrakCare Configuration (InterSystems IRIS Native API)
# Uses @intersystems/intersystems-iris-native SDK
# Connects via IRIS Super Server protocol (port 56772)
TRAKCARE_HOST=100.96.26.65
TRAKCARE_PORT=56772
TRAKCARE_NAMESPACE=TRAK
TRAKCARE_USER=mekc-skumar
TRAKCARE_PASSWORD=KCHJ@1234
TRAKCARE_TIMEOUT=10

# Security Configuration
BCRYPT_ROUNDS=10
SESSION_TIMEOUT_MINUTES=60
IDLE_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=365

# Application Settings
APP_NAME=Human Milk Tracker
APP_VERSION=1.0.0
HOSPITAL_NAME=King's College Hospital Jeddah
HIMSS6_MODE=true

# Feature Flags
ENABLE_TRAKCARE_SYNC=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PASSWORD_RESET=true
